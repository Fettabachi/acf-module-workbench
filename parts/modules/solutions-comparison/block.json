{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acf/solutions-comparison",
	"version": "1.0.3",
	"title": "Solutions Comparison",
	"category": "design",
	"icon": "columns",
	"description": "Compares B2B solutions against a shared set of buying criteria.",
	"keywords": ["solutions", "comparison", "services", "products", "decision"],
	"textdomain": "acf-module-workbench",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		}
	},
	"acf": {
		"blockVersion": 3,
		"expandedEditorButtonText": "Edit comparison",
		"expandedEditorButtons": ["toolbar", "sidebar"],
		"hideFieldsInSidebar": true,
		"mode": "preview",
		"renderTemplate": "solutions-comparison.php"
	},
	"supports": {
		"align": ["wide"],
		"anchor": true,
		"html": false
	},
	"editorScript": "file:./solutions-comparison-editor.js",
	"editorStyle": "file:./solutions-comparison-editor.css",
	"style": "file:./solutions-comparison.css"
}
