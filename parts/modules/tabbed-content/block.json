{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acf/tabbed-content",
	"version": "1.2.1",
	"title": "Tabbed Content",
	"category": "design",
	"icon": "index-card",
	"description": "Organizes related rich content into an accessible tab interface.",
	"keywords": ["tabs", "content", "panels"],
	"textdomain": "acf-module-workbench",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		}
	},
	"acf": {
		"mode": "edit",
		"renderTemplate": "tabbed-content.php"
	},
	"editorScript": "file:./tabbed-content-editor.js",
	"editorStyle": "file:./tabbed-content-editor.css",
	"supports": {
		"align": ["wide"],
		"anchor": true,
		"html": false
	},
	"script": "file:./tabbed-content.js",
	"style": "file:./tabbed-content.css"
}
