{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acf/proof-logos",
	"version": "1.0.0",
	"title": "Proof Logos",
	"category": "design",
	"icon": "screenoptions",
	"description": "Presents a flexible logo cloud for clients, partners, press, integrations, or sponsors.",
	"keywords": ["logo", "proof", "clients", "partners", "press"],
	"textdomain": "acf-module-workbench",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		}
	},
	"acf": {
		"blockVersion": 3,
		"expandedEditorButtonText": "Edit proof logos",
		"expandedEditorButtons": ["toolbar", "sidebar"],
		"hideFieldsInSidebar": true,
		"mode": "preview",
		"renderTemplate": "proof-logos.php"
	},
	"supports": {
		"align": ["wide"],
		"anchor": true,
		"html": false
	},
	"editorScript": "file:./proof-logos-editor.js",
	"editorStyle": "file:./proof-logos-editor.css",
	"style": "file:./proof-logos.css"
}
