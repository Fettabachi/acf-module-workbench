{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acf/open-positions",
	"version": "1.0.1",
	"title": "Open Positions",
	"category": "design",
	"icon": "businessperson",
	"description": "Displays live job openings from a public Greenhouse job board.",
	"keywords": ["careers", "jobs", "greenhouse", "recruiting"],
	"textdomain": "acf-module-workbench",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		}
	},
	"acf": {
		"blockVersion": 3,
		"expandedEditorButtonText": "Edit positions",
		"expandedEditorButtons": ["toolbar", "sidebar"],
		"hideFieldsInSidebar": true,
		"mode": "preview",
		"renderTemplate": "open-positions.php"
	},
	"supports": {
		"align": ["wide"],
		"anchor": true,
		"html": false
	},
	"editorStyle": "file:./open-positions-editor.css",
	"style": "file:./open-positions.css"
}
