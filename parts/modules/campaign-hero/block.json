{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acf/campaign-hero",
	"version": "1.0.1",
	"title": "Campaign Hero",
	"category": "design",
	"icon": "cover-image",
	"description": "Introduces a campaign with responsive calls to action and a desktop performance visual.",
	"keywords": ["campaign", "hero", "cta", "responsive"],
	"textdomain": "acf-module-workbench",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		}
	},
	"acf": {
		"blockVersion": 3,
		"expandedEditorButtonText": "Edit campaign content",
		"expandedEditorButtons": ["toolbar", "sidebar"],
		"hideFieldsInSidebar": true,
		"mode": "preview",
		"renderTemplate": "campaign-hero.php"
	},
	"supports": {
		"align": ["wide"],
		"anchor": true,
		"html": false,
		"multiple": false
	},
	"editorStyle": "file:./campaign-hero-editor.css",
	"style": "file:./campaign-hero.css"
}
