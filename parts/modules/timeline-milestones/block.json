{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acf/timeline-milestones",
	"version": "1.1.2",
	"title": "Timeline / Milestones",
	"category": "design",
	"icon": "backup",
	"description": "Presents ordered milestones with dates and categorized supporting notes.",
	"keywords": ["timeline", "milestones", "history", "changelog", "roadmap"],
	"textdomain": "acf-module-workbench",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		}
	},
	"acf": {
		"blockVersion": 3,
		"expandedEditorButtonText": "Edit timeline",
		"expandedEditorButtons": ["toolbar", "sidebar"],
		"hideFieldsInSidebar": true,
		"mode": "preview",
		"renderTemplate": "timeline-milestones.php"
	},
	"supports": {
		"align": ["wide"],
		"anchor": true,
		"html": false
	},
	"editorScript": "file:./timeline-milestones-editor.js",
	"editorStyle": "file:./timeline-milestones-editor.css",
	"style": "file:./timeline-milestones.css"
}
