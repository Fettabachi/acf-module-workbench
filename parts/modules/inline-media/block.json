{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acf/inline-media",
	"version": "1.3.1",
	"title": "Inline Media",
	"category": "design",
	"icon": "controls-play",
	"description": "Pairs editorial context with an accessible, user-initiated video player.",
	"keywords": ["video", "media", "player", "transcript"],
	"textdomain": "acf-module-workbench",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		}
	},
	"acf": {
		"blockVersion": 3,
		"expandedEditorButtonText": "Edit media",
		"expandedEditorButtons": ["toolbar", "sidebar"],
		"hideFieldsInSidebar": true,
		"mode": "preview",
		"renderTemplate": "inline-media.php"
	},
	"supports": {
		"align": ["wide"],
		"anchor": true,
		"html": false
	},
	"editorStyle": "file:./inline-media-editor.css",
	"script": "file:./inline-media.js",
	"style": "file:./inline-media.css"
}
