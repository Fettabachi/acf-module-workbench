{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acf/meet-the-team",
	"version": "1.1.1",
	"title": "Meet the Team",
	"category": "design",
	"icon": "groups",
	"description": "Introduces a curated team with optional profile links and department filtering.",
	"keywords": ["team", "people", "staff", "directory"],
	"textdomain": "acf-module-workbench",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		}
	},
	"acf": {
		"blockVersion": 3,
		"expandedEditorButtonText": "Edit team content",
		"expandedEditorButtons": ["toolbar", "sidebar"],
		"hideFieldsInSidebar": true,
		"mode": "preview",
		"renderTemplate": "meet-the-team.php"
	},
	"supports": {
		"align": ["wide"],
		"anchor": true,
		"html": false
	},
	"editorStyle": "file:./meet-the-team-editor.css",
	"script": "file:./meet-the-team.js",
	"style": "file:./meet-the-team.css"
}
