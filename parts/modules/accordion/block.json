{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acf/accordion",
	"version": "1.0.5",
	"title": "Accessible Accordion",
	"category": "design",
	"icon": "list-view",
	"description": "Presents independently expandable questions and answers.",
	"keywords": ["accordion", "questions", "faq"],
	"textdomain": "acf-module-workbench",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		}
	},
	"acf": {
		"blockVersion": 3,
		"expandedEditorButtonText": "Edit accordion",
		"expandedEditorButtons": ["toolbar", "sidebar"],
		"hideFieldsInSidebar": true,
		"mode": "preview",
		"renderTemplate": "accordion.php"
	},
	"editorScript": "file:./accordion-editor.js",
	"editorStyle": "file:./accordion-editor.css",
	"supports": {
		"align": ["wide"],
		"anchor": true,
		"html": false
	},
	"style": "file:./accordion.css"
}
